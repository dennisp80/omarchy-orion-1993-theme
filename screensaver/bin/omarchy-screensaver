#!/bin/bash
# Orion 1993 screensaver. Installed by the theme's screensaver/install.sh; stands in front of
# Omarchy's own omarchy-screensaver on PATH (see ~/.config/uwsm/env).
#
# When the orion-1993 theme is active it shows the theme's WebGL screensaver in a kiosk browser
# window: gold pixels build the ORION emblem, it explodes, and the background is rebuilt by
# its own pixels flying in from every direction. Without a GPU the page switches to a CPU
# version by itself. If no browser can be started it falls back to Omarchy's text effects,
# tinted in the theme's colors. With any other theme, Omarchy's original runs untouched.
#
# Signals (omarchy-system-lock kills the terminal with pkill, so SIGHUP lands in the middle of `read`)
# only set a flag; cleanup runs once, outside the trap. Calling `exit` from a trap that runs during
# `read` and is also on EXIT made bash 5.3 segfault in read_builtin.

ORIGINAL=/usr/bin/omarchy-screensaver
THEME=orion-1993

if [[ $(cat ~/.local/state/omarchy/current/theme.name 2>/dev/null) != "$THEME" ]]; then
  exec "$ORIGINAL" "$@"
fi

THEME_DIR=$(omarchy-theme-dir "$THEME" 2>/dev/null) || THEME_DIR=~/.config/omarchy/themes/$THEME
PAGE=$THEME_DIR/screensaver/index.html
CLASS=orion-1993-screensaver
# Omarchy starts one screensaver per monitor. Each needs its own browser profile: a second
# instance on the same profile only hands its URL to the first one and never shows a window.
MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name' 2>/dev/null)
PROFILE=~/.cache/orion-1993-screensaver/${MONITOR:-default}

BROWSER=""
for b in chromium google-chrome-stable brave; do
  command -v "$b" >/dev/null && { BROWSER=$b; break; }
done

SIGNALS=(SIGINT SIGTERM SIGHUP SIGQUIT)
stop=0

show_cursor() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null ||
    hyprctl keyword cursor:invisible false &>/dev/null
}

# ─── main mode: WebGL page in a kiosk browser ───
run_webgl() {
  [[ -f $PAGE && -n $BROWSER ]] || return 1

  cleanup() {
    trap - "${SIGNALS[@]}" EXIT   # only once
    kill "$browser" 2>/dev/null
    show_cursor
    # close only our own terminal (the parent), not everything named like the screensaver
    [[ $(ps -o comm= -p "$PPID" 2>/dev/null) =~ ^(alacritty|ghostty|foot|kitty)$ ]] && kill "$PPID" 2>/dev/null
  }
  trap 'stop=1' "${SIGNALS[@]}"
  trap cleanup EXIT

  printf '\033]11;rgb:00/00/00\007'
  hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null ||
    hyprctl keyword cursor:invisible true &>/dev/null

  mkdir -p "$PROFILE"
  # no network: the page follows theme updates (git pull), so it must not be able to phone home.
  # Its own network namespace (just a downed loopback, no root needed) when the kernel allows it; the
  # flags below are a second layer (WebRTC can open UDP past the proxy, the namespace stops that too)
  local no_net=()
  unshare -cn true 2>/dev/null && no_net=(unshare -cn)
  "${no_net[@]}" "$BROWSER" --user-data-dir="$PROFILE" --class="$CLASS" --kiosk --no-first-run \
    --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-features=Translate,TranslateUI \
    --proxy-server=127.0.0.1:9 --proxy-bypass-list='<-loopback>' --host-resolver-rules='MAP * ~NOTFOUND' \
    --force-webrtc-ip-handling-policy=disable_non_proxied_udp \
    --password-store=basic "file://$PAGE" >/dev/null 2>&1 &
  browser=$!   # global, so cleanup finds it on EXIT too

  # wait for the window (at most 8 s), otherwise fall back. Matched on class OR the page title:
  # Chromium on native Wayland may ignore --class, and then the window would never be found.
  local i
  for ((i = 0; i < 40; i++)); do
    hyprctl clients -j | jq -e --arg c "$CLASS" 'any(.[]; .class == $c or (.title | startswith("moo-")))' >/dev/null && break
    sleep 0.2
  done
  if ((i == 40)); then
    kill "$browser" 2>/dev/null
    trap - "${SIGNALS[@]}" EXIT
    ((stop)) && { show_cursor; exit 0; }
    return 1
  fi

  # quit when the page sets its title to "moo-exit" (Esc, any key, mouse), when the browser
  # dies, or on a key press in the terminal underneath. A signal interrupts read (status >128) and sets stop
  while ((!stop)) && kill -0 "$browser" 2>/dev/null; do
    hyprctl clients -j | jq -e 'any(.[]; .title | startswith("moo-exit"))' >/dev/null && break
    read -n1 -t 0.3 && break
  done
  cleanup
  return 0
}

run_webgl && exit 0

# ─── fallback: Omarchy's text screensaver with four build-up effects in the theme's colors ───
# Our own copy of the ttfx loop in /usr/bin/omarchy-screensaver rather than a sed-patched copy of it:
# the original's exit_screensaver calls exit from the trap during `read -t 1`, which also crashed bash.
command -v ttfx >/dev/null || exec "$ORIGINAL" "$@"
GOLD="fcdc50 d0a424 947000"
STEEL="d0d0d0 a4a4a4 686868"
orion_effect() {
  local effects=(
    "scattered --movement-speed 0.3 --movement-easing in_out_back --final-gradient-stops fcdc50 d0a424 c048c0 --final-gradient-direction vertical"
    "swarm --base-color c048c0 --flash-color fcdc50 --swarm-size 0.1 --final-gradient-stops $GOLD --final-gradient-direction vertical"
    "unstable --unstable-color c048c0 --final-gradient-stops fcdc50 d0a424 a4a4a4 --final-gradient-direction vertical"
    "errorcorrect --error-color fc2828 --correct-color 48cc24 --final-gradient-stops $GOLD $STEEL --final-gradient-direction vertical"
  )
  echo "${effects[RANDOM % ${#effects[@]}]}"
}

cleanup_ttfx() {
  trap - "${SIGNALS[@]}" EXIT
  show_cursor
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null   # like the original: every screensaver (one per monitor)
}
trap 'stop=1' "${SIGNALS[@]}"
trap cleanup_ttfx EXIT

printf '\033]11;rgb:00/00/00\007'
hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null ||
  hyprctl keyword cursor:invisible true &>/dev/null

# the terminal starts at 80x24 and is resized once the compositor answers; ttfx measures only once
deadline=$((SECONDS + 2))
while ((!stop && SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
  sleep 0.02
done

tty=$(tty 2>/dev/null)
while ((!stop)); do
  # shellcheck disable=SC2046 # the effect is meant to split into arguments
  ttfx -i ~/.config/omarchy/branding/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --no-eol --no-restore-cursor $(orion_effect) &

  while ((!stop)) && pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    read -n1 -t 1 && stop=1
    ((stop)) && break
    hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1 || stop=1
  done
done
cleanup_ttfx
exit 0
